# Demo only. Use a long, randomly generated SECRET_KEY before deployment.
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///./dental_demo.db
DEMO_SEED=true
COOKIE_SECURE=false

# Optional private password for all initial sample accounts (12+ characters).
# Applied only when seeding an empty database; does not reset existing accounts.
# DEMO_PASSWORD=choose-a-private-password
